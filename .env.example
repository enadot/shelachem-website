# משתני סביבה לאתר (Next.js). באתר החי מגדירים אותם ב-Vercel ▸ Settings ▸ Environment Variables.
# ללא המשתנים האלה האתר עובד מהתוכן המקומי שב-src/lib/content/local/, אבל אי אפשר
# להתחבר ללוח הבקרה ולשמור בו.

# ─── מסד הנתונים (Neon Postgres) ─────────────────────────────────────────────
# נוצר אוטומטית כשמחברים Neon לפרויקט (Vercel ▸ Storage). תוכן, הגדרות אתר,
# משתמשי הלוח וגיבוי הלידים. הקמה: npm run db:migrate && npm run db:seed -- --admin-email ... --admin-name ...
DATABASE_URL=

# ─── תמונות (Vercel Blob) ────────────────────────────────────────────────────
# נוצר אוטומטית כשמחברים Blob store לפרויקט. העלאת תמונות מהלוח.
BLOB_READ_WRITE_TOKEN=

# ─── BARAM Leads ─────────────────────────────────────────────────────────────
# מפתח API למסכי הלידים בלוח (BARAM ▸ הגדרות ▸ "API ו-MCP" ▸ מפתח חדש, ללקוח "שלכם",
# קריאה + כתיבה). שליחת הלידים מהאתר עובדת גם בלעדיו — דרך כתובות ה-webhook שבהגדרות האתר.
BARAM_LEADS_API_KEY=

# ─── לוח הבקרה (/admin) ───────────────────────────────────────────────────────
# אין משתני שיווק: GTM, פיקסלים, Consent, אימותי בעלות, טלפון וסניפים נערכים
# בלוח הבקרה ונשמרים במסד.
