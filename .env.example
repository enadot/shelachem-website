# משתני סביבה לאתר (Next.js). באתר החי מגדירים אותם בפאנל הפריסה (Vercel וכו').
# ללא המשתנים האלה — האתר עובד מצוין מהתוכן המקומי שב-src/lib/content/local/.

# כתובת ה-CMS. משהוגדר — האתר קורא תוכן מ-Directus (עם נפילה חזרה לתוכן המקומי).
DIRECTUS_URL=https://cms.shelachem.net

# אופציונלי: token לקריאה. לא חובה — נתנו הרשאת קריאה ציבורית ב-Directus,
# אז די ב-DIRECTUS_URL. הגדר token רק אם תסגור בעתיד את הקריאה הציבורית.
# DIRECTUS_STATIC_TOKEN=

# סוד לרענון האתר מ-webhook של Directus (POST /api/revalidate?secret=...).
# חייב להיות זהה ל-secret שמוגדר ב-Flow של Directus.
REVALIDATE_SECRET=

# ─── שיווק דיגיטלי ומדידה ─────────────────────────────────────────────────────
# כל המשתנים אופציונליים: ריק = התג לא נטען. מדריך מלא: docs/marketing.md
# ⚠️ כל פיקסל ממקום אחד בלבד — או כאן (טעינה ישירה) או בתוך GTM, לא בשניהם.

# Google Tag Manager — הדרך המומלצת. את GA4/Ads/Meta/TikTok מגדירים בתוך הקונטיינר.
NEXT_PUBLIC_GTM_ID=

# טעינה ישירה (רק אם לא משתמשים ב-GTM עבור אותה מערכת):
# NEXT_PUBLIC_GA4_ID=G-XXXXXXXXXX
# NEXT_PUBLIC_GOOGLE_ADS_ID=AW-XXXXXXXXX
# NEXT_PUBLIC_GOOGLE_ADS_LEAD_LABEL=        # תווית ההמרה "ליד" מ-Google Ads
# NEXT_PUBLIC_META_PIXEL_ID=
# NEXT_PUBLIC_TIKTOK_PIXEL_ID=
# NEXT_PUBLIC_LINKEDIN_PARTNER_ID=
# NEXT_PUBLIC_LINKEDIN_LEAD_CONVERSION_ID=
# NEXT_PUBLIC_CLARITY_ID=

# true → באנר עוגיות + Consent Mode במצב denied עד אישור הגולש.
# NEXT_PUBLIC_CONSENT_REQUIRED=false
# true → טלפון/מייל מגובבים (SHA-256) באירוע הליד, ל-Enhanced Conversions / Advanced Matching.
# NEXT_PUBLIC_ENHANCED_CONVERSIONS=false

# אימות בעלות (הערך בלבד, בלי תג ה-meta):
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# NEXT_PUBLIC_BING_SITE_VERIFICATION=
# NEXT_PUBLIC_FACEBOOK_DOMAIN_VERIFICATION=
